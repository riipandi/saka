{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/riipandi/tango/refs/heads/main/public/config.schema.json",
    "title": "Tango application configuration",
    "description": "Schema for app.config.json. Every scalar value may be written literally or as an `env:NAME` directive — a reference into the environment table the file resolves from — so boolean and number keys accept the directive string as well as their own type. Durations are written as plain numbers of seconds. Keep this schema in sync with internal/config: every key needs a default in config.Default, a rule in config.Validate, and an entry here.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "description": "JSON Schema the file validates against.",
            "type": "string"
        },
        "app": {
            "description": "Process-level settings.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "mode": {
                    "description": "Runtime mode. The exposure aids (expose_reset_token, expose_totp_secret) are refused outside development.",
                    "anyOf": [
                        {
                            "enum": ["development", "staging", "production", "test"]
                        },
                        {
                            "$ref": "#/$defs/envDirective"
                        }
                    ],
                    "default": "development"
                },
                "secret_key": {
                    "description": "Hex-encoded AES-256 key used to seal stored values. Secret: 64 hex characters, or an env directive.",
                    "$ref": "#/$defs/stringOrEnv"
                },
                "base_url": {
                    "description": "Public origin used to build absolute links. Empty by default.",
                    "$ref": "#/$defs/stringOrEnv"
                },
                "assets_url": {
                    "description": "Where the browser fetches static assets from. Defaults to the built-in /static mount.",
                    "$ref": "#/$defs/stringOrEnv"
                },
                "expose_reset_token": {
                    "description": "Answer the raw password-reset token in the ForgotPassword response. Development mode only.",
                    "$ref": "#/$defs/boolOrEnv",
                    "default": false
                },
                "expose_totp_secret": {
                    "description": "Answer the decrypted authenticator secret in ListTotpEnrollments. Development mode only.",
                    "$ref": "#/$defs/boolOrEnv",
                    "default": false
                },
                "audit_retention_days": {
                    "description": "How long an audit record is kept; the audit_cleanup job deletes what is older. Must be greater than 0.",
                    "$ref": "#/$defs/integerOrEnv",
                    "default": 90
                }
            }
        },
        "auth": {
            "description": "JWT signing material and the token/session settings.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "private_key": {
                    "description": "Base64 (raw, unpadded) JWK JSON of the signing key. Secret.",
                    "$ref": "#/$defs/stringOrEnv"
                },
                "public_key": {
                    "description": "Base64 (raw, unpadded) JWK JSON of the verifying key, required when private_key is set.",
                    "$ref": "#/$defs/stringOrEnv"
                },
                "secret_key": {
                    "description": "Hex-encoded HMAC key, used when no key pair is given. Secret.",
                    "$ref": "#/$defs/stringOrEnv"
                },
                "jwt_algorithm": {
                    "description": "Algorithm a token is signed with when both stacks are configured. Empty derives it.",
                    "$ref": "#/$defs/stringOrEnv"
                },
                "issuer": {
                    "description": "The iss claim placed in every token.",
                    "$ref": "#/$defs/stringOrEnv",
                    "default": "tango"
                },
                "access_ttl": {
                    "description": "Access token lifetime, seconds.",
                    "$ref": "#/$defs/numberOrEnv",
                    "default": 900
                },
                "refresh_short_ttl": {
                    "description": "Unremembered refresh token lifetime, seconds.",
                    "$ref": "#/$defs/numberOrEnv",
                    "default": 43200
                },
                "refresh_long_ttl": {
                    "description": "Remembered refresh token lifetime, seconds.",
                    "$ref": "#/$defs/numberOrEnv",
                    "default": 1209600
                },
                "expiry_email_enabled": {
                    "description": "Turns the API key expiry reminder on. Off by default.",
                    "$ref": "#/$defs/boolOrEnv",
                    "default": false
                },
                "session_driver": {
                    "description": "Backend the sign-in session store reads.",
                    "anyOf": [
                        {
                            "enum": ["database", "kvstore"]
                        },
                        {
                            "$ref": "#/$defs/envDirective"
                        }
                    ],
                    "default": "database"
                },
                "one_time_access_email_as_admin_enabled": {
                    "description": "Administrative one-time access email. Opt-in.",
                    "$ref": "#/$defs/boolOrEnv",
                    "default": false
                },
                "one_time_access_email_as_unauthenticated_enabled": {
                    "description": "Public one-time access email. Opt-in.",
                    "$ref": "#/$defs/boolOrEnv",
                    "default": false
                }
            }
        },
        "cache": {
            "description": "Cache settings. Off by default; a driver configured while the cache is off is never read.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enable": {
                    "$ref": "#/$defs/boolOrEnv",
                    "default": false
                },
                "driver": {
                    "anyOf": [
                        {
                            "enum": ["memory", "kvstore"]
                        },
                        {
                            "$ref": "#/$defs/envDirective"
                        }
                    ],
                    "default": "memory"
                },
                "ttl": {
                    "description": "Default lifetime of a cached entry, seconds.",
                    "$ref": "#/$defs/numberOrEnv",
                    "default": 300
                },
                "max_memory": {
                    "description": "Byte budget of the in-memory driver; the driver resets itself when it runs out.",
                    "$ref": "#/$defs/integerOrEnv",
                    "default": 33554432
                }
            }
        },
        "database": {
            "description": "Postgres connection and pool settings, mirroring the datastore pool options.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "url": {
                    "description": "Connection string. The one secret that must never be logged.",
                    "$ref": "#/$defs/stringOrEnv"
                },
                "max_conns": {
                    "$ref": "#/$defs/integerOrEnv"
                },
                "min_conns": {
                    "$ref": "#/$defs/integerOrEnv"
                },
                "max_conn_lifetime": {
                    "description": "Seconds.",
                    "$ref": "#/$defs/numberOrEnv"
                },
                "max_conn_idle_time": {
                    "description": "Seconds.",
                    "$ref": "#/$defs/numberOrEnv"
                },
                "connect_timeout": {
                    "description": "Bounds the initial connection attempt, seconds.",
                    "$ref": "#/$defs/numberOrEnv"
                },
                "connect_attempts": {
                    "description": "Startup probe attempts before the run fails. 1 reports instead of waiting.",
                    "$ref": "#/$defs/integerOrEnv",
                    "default": 1
                },
                "connect_retry_interval": {
                    "description": "Wait between two startup probe attempts, seconds.",
                    "$ref": "#/$defs/numberOrEnv"
                },
                "search_path": {
                    "description": "Applied to every pooled connection.",
                    "$ref": "#/$defs/stringOrEnv"
                },
                "timezone": {
                    "description": "Applied to every pooled connection.",
                    "$ref": "#/$defs/stringOrEnv"
                }
            }
        },
        "fetcher": {
            "description": "Outbound HTTP client resilience shared by every external call.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "user_agent": {
                    "description": "Product token sent on every request.",
                    "$ref": "#/$defs/stringOrEnv"
                },
                "timeout": {
                    "description": "Bounds one attempt, seconds.",
                    "$ref": "#/$defs/numberOrEnv"
                },
                "retry_count": {
                    "description": "Extra attempts after a transient failure. Zero disables retry; POST and PATCH are never retried.",
                    "$ref": "#/$defs/integerOrEnv"
                },
                "retry_wait": {
                    "description": "Floor of the jittered exponential backoff, seconds.",
                    "$ref": "#/$defs/numberOrEnv"
                },
                "retry_max_wait": {
                    "description": "Ceiling of the backoff, seconds.",
                    "$ref": "#/$defs/numberOrEnv"
                },
                "circuit_failure_threshold": {
                    "description": "Failed attempts that open the breaker.",
                    "$ref": "#/$defs/integerOrEnv"
                },
                "circuit_success_threshold": {
                    "description": "Successful probes that close the breaker.",
                    "$ref": "#/$defs/integerOrEnv"
                },
                "circuit_reset_timeout": {
                    "description": "How long an open breaker waits before probing, seconds.",
                    "$ref": "#/$defs/numberOrEnv"
                },
                "max_body_bytes": {
                    "description": "Body size one response may carry.",
                    "$ref": "#/$defs/integerOrEnv"
                }
            }
        },
        "kvstore": {
            "description": "Optional key-value backend (Valkey).",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enable": {
                    "description": "A driver set to kvstore while this is false is a contradiction Validate reports.",
                    "$ref": "#/$defs/boolOrEnv",
                    "default": false
                },
                "url": {
                    "description": "Connection string, e.g. redis://default:password@localhost:6379. Secret.",
                    "$ref": "#/$defs/stringOrEnv"
                },
                "db": {
                    "description": "Logical database index to select.",
                    "$ref": "#/$defs/integerOrEnv"
                }
            }
        },
        "log": {
            "description": "Logging settings. log.transport names the sinks in order; a section is read only when its transport is named.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "level": {
                    "anyOf": [
                        {
                            "enum": ["debug", "info", "warn", "error"]
                        },
                        {
                            "$ref": "#/$defs/envDirective"
                        }
                    ],
                    "default": "info"
                },
                "transport": {
                    "description": "Sinks to write to, in order. The list is what switches a sink on. May also be a single `env:NAME` directive the environment resolves into the list.",
                    "anyOf": [
                        {
                            "type": "array",
                            "items": {
                                "enum": ["console", "file", "otlp"]
                            }
                        },
                        {
                            "$ref": "#/$defs/stringOrEnv"
                        }
                    ],
                    "default": ["console"]
                },
                "format": {
                    "description": "The console sink's rendering — the only sink a person reads.",
                    "anyOf": [
                        {
                            "enum": ["pretty", "structured"]
                        },
                        {
                            "$ref": "#/$defs/envDirective"
                        }
                    ],
                    "default": "pretty"
                },
                "file": {
                    "description": "Rotating file sink. No filename key: the sink writes to storage.local_path + /logs + tango.log.",
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "max_size": {
                            "description": "Megabytes the active file reaches before rotation.",
                            "$ref": "#/$defs/integerOrEnv"
                        },
                        "max_backups": {
                            "description": "Rotated files kept. Zero with max_age zero keeps every file forever.",
                            "$ref": "#/$defs/integerOrEnv"
                        },
                        "max_age": {
                            "description": "Days a rotated file is kept.",
                            "$ref": "#/$defs/integerOrEnv"
                        },
                        "compress": {
                            "description": "Gzip a rotated file.",
                            "$ref": "#/$defs/boolOrEnv"
                        }
                    }
                },
                "otlp": {
                    "description": "Log export route; the collector address lives in otel.endpoint.",
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "path": {
                            "description": "Collector route for logs. Empty means the protocol's own /v1/logs.",
                            "$ref": "#/$defs/stringOrEnv"
                        },
                        "timeout": {
                            "description": "Bounds one export attempt, seconds.",
                            "$ref": "#/$defs/numberOrEnv"
                        }
                    }
                }
            }
        },
        "mailer": {
            "description": "SMTP submission. An empty smtp_host means the mailer is not configured — not an error.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "from_email": {
                    "description": "Sender every message is sent as.",
                    "$ref": "#/$defs/stringOrEnv"
                },
                "from_name": {
                    "$ref": "#/$defs/stringOrEnv"
                },
                "smtp_host": {
                    "$ref": "#/$defs/stringOrEnv"
                },
                "smtp_port": {
                    "description": "Submission port: 587 for STARTTLS, 465 for implicit TLS.",
                    "$ref": "#/$defs/integerOrEnv"
                },
                "smtp_username": {
                    "$ref": "#/$defs/stringOrEnv"
                },
                "smtp_password": {
                    "description": "Secret.",
                    "$ref": "#/$defs/stringOrEnv"
                },
                "smtp_secure": {
                    "description": "Implicit TLS on connect instead of STARTTLS.",
                    "$ref": "#/$defs/boolOrEnv"
                },
                "smtp_allow_plaintext_auth": {
                    "description": "Permit a credential over an unencrypted connection to a non-loopback host. Opt-in.",
                    "$ref": "#/$defs/boolOrEnv",
                    "default": false
                },
                "timeout": {
                    "description": "Bounds one mail submission, seconds.",
                    "$ref": "#/$defs/numberOrEnv",
                    "default": 15
                },
                "notifications": {
                    "description": "Which notice emails a deployment pays for. The transactional emails (password reset, email verification, one-time access, the email-change token) are not gated: they carry the flow itself.",
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "new_device_notice_enabled": {
                            "$ref": "#/$defs/boolOrEnv",
                            "default": true
                        },
                        "password_changed_notice_enabled": {
                            "$ref": "#/$defs/boolOrEnv",
                            "default": true
                        },
                        "mfa_disabled_notice_enabled": {
                            "$ref": "#/$defs/boolOrEnv",
                            "default": true
                        },
                        "user_banned_notice_enabled": {
                            "$ref": "#/$defs/boolOrEnv",
                            "default": true
                        },
                        "user_unbanned_notice_enabled": {
                            "$ref": "#/$defs/boolOrEnv",
                            "default": true
                        },
                        "api_key_expiring_notice_enabled": {
                            "$ref": "#/$defs/boolOrEnv",
                            "default": true
                        },
                        "email_change_notice_enabled": {
                            "$ref": "#/$defs/boolOrEnv",
                            "default": true
                        }
                    }
                }
            }
        },
        "otel": {
            "description": "Traces and metrics. One collector address serves every signal; a section is read only when its signal is on.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "endpoint": {
                    "description": "Collector's OTLP address, e.g. http://localhost:4318 or localhost:4317 for gRPC.",
                    "$ref": "#/$defs/stringOrEnv"
                },
                "service_name": {
                    "description": "Service every signal is attributed to.",
                    "$ref": "#/$defs/stringOrEnv"
                },
                "environment": {
                    "description": "Deployment a signal came from, e.g. production or staging.",
                    "$ref": "#/$defs/stringOrEnv"
                },
                "protocol": {
                    "description": "Wire protocol every signal is sent with.",
                    "anyOf": [
                        {
                            "enum": ["grpc", "http/protobuf", "http/json"]
                        },
                        {
                            "$ref": "#/$defs/envDirective"
                        }
                    ]
                },
                "compression": {
                    "anyOf": [
                        {
                            "enum": ["gzip", "none"]
                        },
                        {
                            "$ref": "#/$defs/envDirective"
                        }
                    ]
                },
                "headers": {
                    "description": "Headers attached to every export. May also be a single `env:NAME` directive.",
                    "anyOf": [
                        {
                            "type": "object",
                            "additionalProperties": {
                                "$ref": "#/$defs/stringOrEnv"
                            }
                        },
                        {
                            "$ref": "#/$defs/stringOrEnv"
                        }
                    ]
                },
                "queue": {
                    "description": "Exporter's in-memory queue.",
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "max_size": {
                            "$ref": "#/$defs/integerOrEnv",
                            "default": 4096
                        }
                    }
                },
                "tracing": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "enable": {
                            "$ref": "#/$defs/boolOrEnv",
                            "default": false
                        },
                        "path": {
                            "description": "Collector route for traces. Empty means the protocol's own /v1/traces.",
                            "$ref": "#/$defs/stringOrEnv"
                        },
                        "sampler": {
                            "anyOf": [
                                {
                                    "enum": ["always", "never", "ratio", "parent_ratio"]
                                },
                                {
                                    "$ref": "#/$defs/envDirective"
                                }
                            ]
                        },
                        "ratio": {
                            "description": "Fraction of traces recorded; read only by the ratio samplers.",
                            "$ref": "#/$defs/numberOrEnv"
                        },
                        "batch_timeout": {
                            "description": "How long a span waits in the queue before export, seconds.",
                            "$ref": "#/$defs/numberOrEnv"
                        },
                        "export_timeout": {
                            "description": "Bounds one trace export, seconds.",
                            "$ref": "#/$defs/numberOrEnv"
                        },
                        "max_batch_size": {
                            "$ref": "#/$defs/integerOrEnv"
                        }
                    }
                },
                "metrics": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "enable": {
                            "$ref": "#/$defs/boolOrEnv",
                            "default": false
                        },
                        "push": {
                            "description": "Push metrics over OTLP instead of serving the Prometheus bridge.",
                            "$ref": "#/$defs/boolOrEnv"
                        },
                        "path": {
                            "description": "Collector route for metrics. Empty means the protocol's own /v1/metrics.",
                            "$ref": "#/$defs/stringOrEnv"
                        },
                        "prometheus_path": {
                            "description": "Path the Prometheus bridge is served at.",
                            "$ref": "#/$defs/stringOrEnv"
                        },
                        "interval": {
                            "description": "Metrics collection interval, seconds.",
                            "$ref": "#/$defs/numberOrEnv"
                        },
                        "export_timeout": {
                            "description": "Bounds one metrics export, seconds.",
                            "$ref": "#/$defs/numberOrEnv"
                        }
                    }
                }
            }
        },
        "queue": {
            "description": "Durable Postgres task queue and the cron scheduler that enqueues onto it.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "num_workers": {
                    "description": "Goroutines executing queued tasks concurrently.",
                    "$ref": "#/$defs/integerOrEnv",
                    "default": 5
                },
                "release_after": {
                    "description": "How long a claimed task may run before the queue hands it to another worker. Must exceed every queue's timeout, seconds.",
                    "$ref": "#/$defs/numberOrEnv",
                    "default": 3600
                },
                "cleanup_interval": {
                    "description": "How often the maintenance job deletes expired completed records, seconds.",
                    "$ref": "#/$defs/numberOrEnv",
                    "default": 3600
                },
                "encrypt": {
                    "description": "Seals task payloads at rest with app.secret_key.",
                    "$ref": "#/$defs/boolOrEnv",
                    "default": false
                },
                "timezone": {
                    "description": "Resolves a cron spec that names no zone of its own.",
                    "$ref": "#/$defs/stringOrEnv",
                    "default": "UTC"
                }
            }
        },
        "rate_limit": {
            "description": "Request throttling.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "driver": {
                    "anyOf": [
                        {
                            "enum": ["database", "kvstore"]
                        },
                        {
                            "$ref": "#/$defs/envDirective"
                        }
                    ],
                    "default": "database"
                },
                "limit": {
                    "description": "Requests allowed per window.",
                    "$ref": "#/$defs/integerOrEnv",
                    "default": 60
                },
                "window": {
                    "description": "Period the limit applies to, seconds.",
                    "$ref": "#/$defs/numberOrEnv",
                    "default": 60
                }
            }
        },
        "server": {
            "description": "HTTP server settings.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "host": {
                    "$ref": "#/$defs/stringOrEnv",
                    "default": "0.0.0.0"
                },
                "port": {
                    "$ref": "#/$defs/integerOrEnv",
                    "default": 3080
                },
                "read_timeout": {
                    "description": "Seconds.",
                    "$ref": "#/$defs/numberOrEnv",
                    "default": 15
                },
                "write_timeout": {
                    "description": "Seconds.",
                    "$ref": "#/$defs/numberOrEnv",
                    "default": 30
                },
                "idle_timeout": {
                    "description": "Seconds.",
                    "$ref": "#/$defs/numberOrEnv",
                    "default": 60
                },
                "shutdown_timeout": {
                    "description": "Bounds the graceful shutdown drain, seconds.",
                    "$ref": "#/$defs/numberOrEnv"
                },
                "max_request_bytes": {
                    "description": "Body size one RPC request may carry; a larger one is refused before a procedure runs.",
                    "$ref": "#/$defs/integerOrEnv"
                },
                "trusted_proxy_headers": {
                    "description": "Headers the deployment's reverse proxies set the client address in, in precedence order. Empty means the process is reached directly. A list, or a single `env:NAME` directive.",
                    "$ref": "#/$defs/stringListOrEnv"
                },
                "cors": {
                    "description": "Browser cross-origin policy. Empty allowed_origins disables cross-origin access.",
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "allowed_origins": {
                            "description": "Origins a browser may call from, scheme://host without a path, or * for any. A list, or a single `env:NAME` directive.",
                            "$ref": "#/$defs/stringListOrEnv"
                        },
                        "allowed_methods": {
                            "$ref": "#/$defs/stringListOrEnv"
                        },
                        "allowed_headers": {
                            "$ref": "#/$defs/stringListOrEnv"
                        },
                        "exposed_headers": {
                            "description": "Response headers a browser script may read on a cross-origin response.",
                            "$ref": "#/$defs/stringListOrEnv"
                        },
                        "allow_credentials": {
                            "description": "Forbidden with a wildcard origin; Validate refuses the combination.",
                            "$ref": "#/$defs/boolOrEnv"
                        },
                        "max_age": {
                            "description": "How long a preflight may be cached, seconds.",
                            "$ref": "#/$defs/numberOrEnv"
                        }
                    }
                }
            }
        },
        "storage": {
            "description": "File engine over the local filesystem or S3.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "driver": {
                    "enum": ["local", "s3"],
                    "default": "local"
                },
                "local_path": {
                    "description": "Directory the local driver writes to — the one data directory of the process.",
                    "$ref": "#/$defs/stringOrEnv"
                },
                "watch": {
                    "description": "Staging watcher: notices a finished staging file and enqueues the upload.",
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "enable": {
                            "$ref": "#/$defs/boolOrEnv"
                        },
                        "debounce": {
                            "description": "Quiet period before a changed staging file is acted on, seconds.",
                            "$ref": "#/$defs/numberOrEnv"
                        }
                    }
                },
                "s3": {
                    "description": "Object-storage settings, read only on the s3 driver.",
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "access_key_id": {
                            "description": "Secret.",
                            "$ref": "#/$defs/stringOrEnv"
                        },
                        "access_key_secret": {
                            "description": "Secret.",
                            "$ref": "#/$defs/stringOrEnv"
                        },
                        "bucket_name": {
                            "$ref": "#/$defs/stringOrEnv"
                        },
                        "endpoint_url": {
                            "description": "Base URL of a service other than AWS, e.g. http://localhost:9100. Empty means AWS, addressed through region.",
                            "$ref": "#/$defs/stringOrEnv"
                        },
                        "force_path_style": {
                            "description": "Address a bucket as a path segment (host/bucket/key) instead of a subdomain. MinIO and Silo need it.",
                            "$ref": "#/$defs/boolOrEnv"
                        },
                        "path_prefix": {
                            "description": "Key prefix objects are stored under. Empty means the bucket root.",
                            "$ref": "#/$defs/stringOrEnv"
                        },
                        "region": {
                            "description": "Signing region. Required even when endpoint_url is set — the client refuses to resolve an endpoint without one.",
                            "$ref": "#/$defs/stringOrEnv"
                        },
                        "signed_url_expires": {
                            "description": "How long a presigned link stays valid, seconds.",
                            "$ref": "#/$defs/numberOrEnv",
                            "default": 3600
                        }
                    }
                }
            }
        }
    },
    "$defs": {
        "stringOrEnv": {
            "description": "A literal string or an `env:NAME` directive resolved from the environment table.",
            "type": "string"
        },
        "envDirective": {
            "description": "An `env:NAME` reference into the environment table the file resolves from.",
            "type": "string",
            "pattern": "^env:[A-Za-z_][A-Za-z0-9_]*$"
        },
        "stringListOrEnv": {
            "description": "A list of strings, or a single `env:NAME` directive the environment resolves into the list.",
            "anyOf": [
                {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                {
                    "$ref": "#/$defs/envDirective"
                }
            ]
        },
        "boolOrEnv": {
            "anyOf": [
                {
                    "type": "boolean"
                },
                {
                    "$ref": "#/$defs/envDirective"
                }
            ]
        },
        "integerOrEnv": {
            "anyOf": [
                {
                    "type": "integer"
                },
                {
                    "$ref": "#/$defs/envDirective"
                }
            ]
        },
        "numberOrEnv": {
            "anyOf": [
                {
                    "type": "number"
                },
                {
                    "$ref": "#/$defs/envDirective"
                }
            ]
        }
    }
}
